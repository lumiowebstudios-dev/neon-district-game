<Application x:Class="DeepVault.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:DeepVault.App.Services"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
                <ResourceDictionary Source="Views/Converters.xaml"/>
                <ResourceDictionary Source="Views/ScanPages.xaml"/>
                <ResourceDictionary Source="Views/ResultPages.xaml"/>
                <ResourceDictionary Source="Views/RestorePages.xaml"/>
                <ResourceDictionary Source="Views/OtherPages.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
