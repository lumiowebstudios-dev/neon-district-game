<Window x:Class="DeepVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepVault — Data Recovery" Width="1320" Height="860" MinWidth="980" MinHeight="640"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" Icon="Assets/deepvault.ico"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,18,18,14">
                    <Image Source="Assets/deepvault.png" Width="34" Height="34"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DeepVault" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Read-only data recovery" FontSize="11" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Margin="14" Padding="10" CornerRadius="6" Background="{StaticResource Surface2}">
                    <StackPanel>
                        <TextBlock Text="Source drive is only ever read." FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <TextBlock Text="No telemetry • no internet" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <ListBox x:Name="NavList" ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItem}" KeyboardNavigation.TabNavigation="Once">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="-6,4,-6,10"
                                        Visibility="{Binding StartsGroup, Converter={StaticResource Vis}}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface3}" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Number}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="13.5"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content -->
        <DockPanel Grid.Column="1" Grid.Row="0">
            <Border DockPanel.Dock="Top" Style="{StaticResource DangerBanner}" Margin="24,16,24,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissError}" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <ContentControl Content="{Binding CurrentPage}" Focusable="False"/>
        </DockPanel>

        <!-- Status bar -->
        <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Restart as administrator" Command="{Binding RestartElevated}" Padding="10,3" Margin="0"
                        Visibility="{Binding IsElevated, Converter={StaticResource NotVis}}"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
